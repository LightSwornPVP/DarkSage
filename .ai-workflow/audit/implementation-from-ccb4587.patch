+"""Run the disposable mock lifecycle and write machine-readable evidence."""
+
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPOSITORY_ROOT))
+
+from keeper.agent_runner import AgentRunner
+from keeper.config import KeeperConfig
+from keeper.models.task import now_iso
+from keeper.orchestrator import Keeper
+from keeper.providers.mock import MockProvider
+from keeper.providers.routing import ProviderRouter
+from keeper.recovery import atomic_write_json
+from keeper.workspace import WorkspaceManager
+
+
+def main() -> int:
+    root = REPOSITORY_ROOT
+    loaded = KeeperConfig.load(root)
+    config = KeeperConfig(
+        repository_root=loaded.repository_root,
+        state_root=loaded.state_root,
+        workspace_root=root / ".ai-workflow" / "pilot-worktrees",
+        provider_command=(),
+        process_timeout_seconds=30,
+    )
+    output_base: dict[str, object] = {
+        "status": "completed",
+        "files_changed": [".keeper-pilot/result.txt"],
+    }
+    builder = MockProvider(
+        output=output_base,
+        provider_name="mock-builder",
+        file_writes={".keeper-pilot/result.txt": "repaired\n"},
+    )
+    reviewer = MockProvider(
+        output={
+            "status": "completed",
+            "files_changed": [],
+            "findings": [
+                {
+                    "severity": "High",
+                    "title": "Simulated blocking fixture finding",
+                    "description": "Reapply the required repaired value during the repair stage.",
+                    "file": ".keeper-pilot/result.txt",
+                    "line": 1,
+                },
+                {
+                    "severity": "Minor",
+                    "title": "Pilot fixture is intentionally terse",
+                    "description": "Record as deferred demonstration cleanup only.",
+                    "file": ".keeper-pilot/result.txt",
+                    "line": 1,
+                },
+            ],
+        },
+        provider_name="mock-reviewer",
+    )
+    repairer = MockProvider(
+        output=output_base,
+        provider_name="mock-repairer",
+        file_writes={".keeper-pilot/result.txt": "repaired\n"},
+    )
+    router = ProviderRouter(
+        {"builder": builder, "reviewer": reviewer, "repairer": repairer},
+        {"builder": "builder", "reviewer": "reviewer", "repairer": "repairer"},
+    )
+    runner = AgentRunner(builder, config.state_root / "runs", 30)
+    manager = WorkspaceManager(config.repository_root, config.workspace_root)
+    keeper = Keeper(config, runner, manager, router)
+    selected = keeper.queue.next()
+    if selected is None:
+        raise RuntimeError("no eligible pilot task")
+    result = keeper.run_task(selected)
+    workspace = config.workspace_root / selected.id
+    run_records = []
+    for path in sorted((config.state_root / "runs").glob(f"{selected.id}-*/run.json")):
+        run_records.append(json.loads(path.read_text(encoding="utf-8")))
+    evidence = {
+        "pilot_id": selected.id,
+        "started_from": "BACKLOG",
+        "final_status": result.status.value,
+        "transition_history": result.transition_history,
+        "run_ids": [item["run_id"] for item in run_records],
+        "providers": [
+            {
+                "role": item["role"],
+                "provider_name": item["provider_name"],
+                "provider_instance_id": item["provider_instance_id"],
+            }
+            for item in run_records
+        ],
+        "verification_recorded": all(
+            item.get("verification_result") is not None
+            for item in run_records
+            if item["role"] == "builder"
+        ),
+        "review_disposition_recorded": any(
+            item.get("accepted_findings") and item.get("rejected_findings")
+            for item in run_records
+            if item["role"] == "reviewer"
+        ),
+        "repair_recorded": any(
+            item.get("repair_history") for item in run_records if item["role"] == "reviewer"
+        ),
+        "workspace_path": str(workspace),
+        "cleanup_status": "pending",
+        "protected_actions": [],
+        "recorded_at": now_iso(),
+    }
+    atomic_write_json(config.state_root / "runs" / "mock-pilot-summary.json", evidence)
+    print(json.dumps(evidence, indent=2))
+    return 0 if result.status.value == "COMPLETED" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
